# TikTok TV Configuration (Public Client Key & Auth Backend URL)
# Note: NEVER place your TikTok client_secret in this file or in the Android APK!
# Keep client_secret exclusively inside auth-backend/.env on your server.
# Configure these values via the Secrets panel in AI Studio.
TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY
TIKTOK_AUTH_BACKEND_URL=https://your-tiktok-tv-auth-backend.example.com
